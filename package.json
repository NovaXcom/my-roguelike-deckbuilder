{
  "name": "my-roguelike-deckbuilder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:local": "tsc --noEmit && vite build --mode singlefile",
    "preview": "vite preview",
    "test": "vitest run",
    "generate-assets": "python scripts/generate_assets.py",
    "generate-assets:force": "python scripts/generate_assets.py --force"
  },
  "dependencies": {
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.2",
    "vitest": "^2.0.0"
  }
}
