{
  "name": "last-day",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "最後の一日 — 2D探索アドベンチャー × タイムループ × ミステリー",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:local": "tsc --noEmit && vite build --mode singlefile",
    "preview": "vite preview",
    "test": "vitest run",
    "pack:itch": "npm run build && cd dist && python3 -m zipfile -c ../last-day-itch.zip index.html assets"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  }
}